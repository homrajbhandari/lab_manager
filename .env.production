# ---------------------------------------------------------------------------
# Production environment — committed template. Real values come from the
# orchestrator (docker --env-file, k8s secret, GitHub Actions env, ...).
# DO NOT put real secrets in this file.
# ---------------------------------------------------------------------------

APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=json
PORT=8000
WORKERS=4

# Database — populated by the deploy pipeline.
DATABASE_URL=postgresql+psycopg2://CHANGE_ME:CHANGE_ME@db:5432/lab_manager

# Auth — REQUIRED. Deployments must fail if this is empty.
SECRET_KEY=__SET_VIA_DEPLOYER__
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# CORS — exact origin(s) of the front-end, comma-separated.
CORS_ORIGINS=https://app.example.com
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Authorization,Content-Type,Accept,X-Request-ID

# Rate limiting — Redis-backed, shared across workers/instances.
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_BURST=20
RATE_LIMIT_BACKEND=redis
REDIS_URL=redis://redis:6379/0

# Uploads.
UPLOAD_ROOT=/app/uploads
MAX_UPLOAD_SIZE_MB=100

# Bootstrap admin.
ADMIN_USERNAME=__SET_VIA_DEPLOYER__
ADMIN_EMAIL=__SET_VIA_DEPLOYER__
ADMIN_PASSWORD=__SET_VIA_DEPLOYER__

# Observability.
SENTRY_DSN=
PROMETHEUS_ENABLED=true
METRICS_PATH=/metrics

# Trust the reverse proxy's X-Forwarded-* headers.
TRUST_PROXY_HEADERS=true
