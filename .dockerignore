# --- Documentation / scripts that are not needed in the image ---------------
docs/
*.md
!README.md
LICENSE
.editorconfig

# --- CI / deployment files that should not leak into the image --------------
.github/
.gitlab-ci.yml
.circleci/
Dockerfile
docker-compose*.yml
.dockerignore
nginx/

# --- Test files (kept out of the production image) -------------------------
tests/
test_*.py
*_test.py
conftest.py
pytest.ini
pyproject.toml
.flake8
.isort.cfg
.black

# --- Local artifacts that do not belong in the image -----------------------
uploads/
tmp/
temp/
node_modules/
dist/
coverage/
