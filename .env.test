# ---------------------------------------------------------------------------
# Test environment — used by pytest and the CI test job.
# The DB is an in-memory SQLite so tests are isolated and parallel-safe.
# ---------------------------------------------------------------------------

APP_ENV=test
DEBUG=true
LOG_LEVEL=WARNING
LOG_FORMAT=text

# In-memory SQLite. Each connection gets its own DB, so tests are isolated.
DATABASE_URL=sqlite:///:memory:

# JWT — fixed test secret; tests do not exercise real signing strength.
SECRET_KEY=test-secret-do-not-use-in-prod
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS — fully open for tests.
CORS_ORIGINS=*
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# Rate limiting disabled for tests.
RATE_LIMIT_PER_MINUTE=0
RATE_LIMIT_BACKEND=memory

# Redis — tests use a fake in-memory backend, this URL is never connected.
REDIS_URL=redis://localhost:6379/15

# Uploads — throwaway dir per test session.
UPLOAD_ROOT=/tmp/lab-manager-test-uploads
MAX_UPLOAD_SIZE_MB=5

# Bootstrap admin used by fixture-based tests.
ADMIN_USERNAME=test_admin
ADMIN_EMAIL=test_admin@example.com
ADMIN_PASSWORD=test-password

# Observability off during tests.
SENTRY_DSN=
PROMETHEUS_ENABLED=false
METRICS_PATH=/metrics
