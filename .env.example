# ---------------------------------------------------------------------------
# lab-manager — environment configuration template
# Copy to .env and fill in real values. Never commit a real .env file.
# ---------------------------------------------------------------------------

# --- Application ------------------------------------------------------------
APP_ENV=development
APP_NAME=lab-manager
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO          # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT=text         # text | json
PORT=8000
WORKERS=2

# --- Database ---------------------------------------------------------------
# SQLite (local dev only):
DATABASE_URL=sqlite:///./lab_manager.db
# PostgreSQL (compose / staging / prod):
# DATABASE_URL=postgresql+psycopg2://lab:lab@db:5432/lab_manager

# --- Auth / JWT -------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-this-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# --- CORS -------------------------------------------------------------------
# Comma-separated list. Use * only in dev.
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
CORS_ALLOW_CREDENTIALS=false
CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Authorization,Content-Type,Accept,X-Request-ID

# --- Rate limiting ----------------------------------------------------------
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_BURST=20
RATE_LIMIT_BACKEND=memory   # memory | redis

# --- Redis ------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- Uploads / storage ------------------------------------------------------
UPLOAD_ROOT=./uploads
MAX_UPLOAD_SIZE_MB=50

# --- Bootstrap admin (created at first start if no users exist) ------------
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# --- Observability ----------------------------------------------------------
SENTRY_DSN=
PROMETHEUS_ENABLED=true
METRICS_PATH=/metrics

# --- SSL / proxy (production) -----------------------------------------------
# Behind nginx / a load balancer set this to "true" so the app trusts the
# X-Forwarded-Proto header.
TRUST_PROXY_HEADERS=true
